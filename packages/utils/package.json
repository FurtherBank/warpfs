{
  "name": "@warpfs/utils",
  "version": "0.1.0",
  "description": "WarpFS utility functions: caching, debounce, diff",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
